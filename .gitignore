# Среда разработки и виртуальные окружения
.venv/
.kilo/
env/
venv/

# Конфиденциальные данные и переменные окружения
.env
.env.*
!.env.example

# Байт-код, кэш и артефакты статического анализа
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Отчеты тестирования и покрытия кода
.coverage
htmlcov/
coverage/
.nyc_output/

# Зависимости и пакетные менеджеры Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Артефакты сборки и метаданные пакетов
*.egg-info/
dist/
build/
project_info/pytest_last_run.txt

# Базы данных и миграции
*.sqlite3

# Системные файлы, дампы и IDE
.idea/
.vscode/
.DS_Store
project_context.txt
